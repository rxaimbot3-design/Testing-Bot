{
  "name": "ultimate-discord-ai-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Military-Grade Discord AI Bot with Zero-Trust Security, Ghost Bypass Protection, and Live Sentiment AI",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development UV_THREADPOOL_SIZE=128 tsx server.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=450 vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "tweetnacl": "^1.0.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
